{
  "name": "air-pro-solutions-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:nearby && npm run check:featured-cities && npm run check:hub-links && next build && npm run check:hero-captions",
    "check:hero-captions": "node scripts/check-hero-captions.mjs",
    "start": "npx serve out",
    "lint": "tsc --noEmit",
    "check:nearby": "node scripts/check-nearby.mjs",
    "report:inbound-links": "node scripts/report-inbound-links.mjs",
    "check:hub-links": "node scripts/check-hub-links.mjs",
    "propose:featured-cities": "node scripts/propose-featured-cities.mjs",
    "check:featured-cities": "node scripts/check-featured-cities.mjs"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}

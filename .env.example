# Contact form (both are required for the production build; see README "Contact form").
# Values are public: they are inlined into the static export. Never put a secret key here.

# Same-origin route served by the Cloudflare Pages Function in functions/api/contact.js.
NEXT_PUBLIC_FORM_ENDPOINT=/api/contact

# Cloudflare Turnstile SITE key (public). Placeholder: replace with the real site key for the production hostname.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile-site-key>

# SERVER-SIDE variables (names only, no values). These are Cloudflare-only: set them under
# Cloudflare Pages > Settings > Environment variables (Production and Preview, as Secrets) or in a local
# .dev.vars file (see .dev.vars.example). Never put them in this file, in .env.local, or in NEXT_PUBLIC_*.
#   TURNSTILE_SECRET_KEY
#   GHL_PRIVATE_INTEGRATION_TOKEN
#   GHL_LOCATION_ID
#   GHL_FIELD_SERVICE_ID
#   GHL_FIELD_SMS_CONSENT_NONMARKETING_ID
#   GHL_FIELD_SMS_CONSENT_MARKETING_ID
#   GHL_FIELD_CONSENT_AT_ID
#   GHL_FIELD_SOURCE_PAGE_ID
# Optional: GHL_API_VERSION (default v3), TURNSTILE_ALLOWED_HOSTNAMES (comma-separated list)

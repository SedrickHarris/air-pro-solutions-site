# Contact form (both are required for the production build; see README "Contact form").
# Values are public: they are inlined into the static export. Never put a secret key here.

# URL that accepts the form POST (multipart form data) and emails it to
# contact@airprosolutionsheatingandcooling.com. Examples: a Formspree form URL,
# or a Cloudflare Pages Function route you create (it must also verify the Turnstile token).
NEXT_PUBLIC_FORM_ENDPOINT=

# Cloudflare Turnstile SITE key (public). The matching secret key belongs to the endpoint, not this repo.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
